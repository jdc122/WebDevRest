@page
@model OceansideRestaurant.Pages.IndexModel
@{
    ViewData["Title"] = "index";
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Identity
@using OceansideRestaurant.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@addTagHelper *, AuthoringTagHelpers

<h2>Index</h2>
@if (SignInManager.IsSignedIn(User))
            {
                <h2>Hello @UserManager.GetUserName(User)</h2>
                if (User.IsInRole("Admin"))
                {
                    <h2>Only admin users can see this!</h2>
                }
            }
<form method="POST">
    @foreach (var X in Model.X)
    {
        <ul>
            <li>@X</li>
        </ul>

    }
    <button type="submit" asp-page-handler="Even">Even</button>
</form>


